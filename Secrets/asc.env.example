# Реквизиты API-ключа App Store Connect для `make testflight`.
# Скопировать в Secrets/asc.env (он в .gitignore; этот example — единственный
# файл каталога Secrets/, который лежит в git) и заполнить.
#
# Откуда: App Store Connect → Users and Access → Integrations → App Store Connect API
# → Team Keys → «+» (роль App Manager). Key ID и Issuer ID видны на той же странице,
# сам ключ — файл AuthKey_<Key ID>.p8, скачивается ОДИН раз; положить в ~/.private_keys/.
# Подробно: docs/TESTFLIGHT.md.

ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=12345678-1234-1234-1234-123456789abc

# Необязательно. По умолчанию ключ ищется в ~/.private_keys/AuthKey_<ASC_KEY_ID>.p8.
# ASC_KEY_PATH=/полный/путь/AuthKey_ABC123DEFG.p8
