build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# ── Swift Package Manager ──
.build/
.swiftpm/
Package.resolved

# ── macOS ──
.DS_Store
*.swp

# ── Логи ──
*.log
