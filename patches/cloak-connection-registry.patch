+// A native connection owns its local pipe and all remote sockets through ctx.
+// Close cancels dial/handshake/retry and closes only this connection's sockets.
+type cloakConnection struct {
+	net.Conn
+	cancel context.CancelFunc
+}
+
+func (c *cloakConnection) Close() error {
+	c.cancel()
+	return c.Conn.Close()
+}
+
+// The plugin opens exactly one local stream per Cloak_dial. A listener would
+// wait forever for a second client and keep old reconnect attempts alive.
+func routeCloak(c *cloakConnection, peer net.Conn, timeout time.Duration, makeSession func() (*multiplex.Session, error)) {
+	defer c.Close()
+	defer peer.Close()
+	sesh, err := makeSession()
+	if err != nil {
+		return
+	}
+	defer func() {
+		// Cancel remote I/O before Close tries to send a closing notification.
+		c.Close()
+		sesh.Close()
+	}()
+	data := make([]byte, 10240)
+	_ = peer.SetReadDeadline(time.Now().Add(timeout))
+	n, err := io.ReadAtLeast(peer, data, 1)
+	if err != nil {
+		return
+	}
+	_ = peer.SetReadDeadline(time.Time{})
+	stream, err := sesh.OpenStream()
+	if err != nil {
+		return
+	}
+	if _, err = stream.Write(data[:n]); err != nil {
+		return
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		io.Copy(peer, stream)
+		c.Close()
+	}()
+	io.Copy(stream, peer)
+	c.Close()
+	<-done
 }
 
