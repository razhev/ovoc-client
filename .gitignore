# ── Секреты (никогда не коммитить) ──
# Secrets/* (а не Secrets/): git не умеет «разыгнорировать» файл внутри
# игнорируемого каталога, а шаблон asc.env.example должен попасть в репозиторий.
Secrets/*
!Secrets/asc.env.example
*.vpnkey
*.ovpn
*.mobileprovision
*.p8
*.p12
*.cer

# ── Бинарные фреймворки (скачиваются скриптом scripts/fetch-framework.sh) ──
Frameworks/

# ── Генерируется XcodeGen ──
*.xcodeproj

# ── Xcode / сборка ──
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# ── Swift Package Manager ──
.build/
.swiftpm/
Package.resolved

# ── macOS ──
.DS_Store
*.swp

# ── Логи ──
*.log
